---
area/ci:
  - changed-files:
      - any-glob-to-any-file: ".github/**/*"
{% if language == "nix" -%}
area/nix:
  - changed-files:
      - any-glob-to-any-file: "**/*.nix"
  - changed-files:
      - any-glob-to-any-file: "flake.lock"
{% elif language != "none" -%}
area/{{ language }}:
  - changed-files:
      - any-glob-to-any-file: "src/**/*"
{% endif -%}
area/docker:
  - changed-files:
      - any-glob-to-any-file: "Dockerfile"
