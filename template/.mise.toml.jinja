[tools]
actionlint = "1.7.12"{# renovate: datasource=github-releases depName=actionlint packageName=rhysd/actionlint #}
hk = "2.6.0"{# renovate: datasource=github-releases depName=hk packageName=jdx/hk #}
pkl = "0.32.1"{# renovate: datasource=github-releases depName=pkl packageName=apple/pkl #}
rumdl = "0.2.55"{# renovate: datasource=github-releases depName=rumdl packageName=rvben/rumdl #}
shellcheck = "0.11.0"{# renovate: datasource=github-releases depName=shellcheck packageName=koalaman/shellcheck #}
tombi = "1.4.0"{# renovate: datasource=github-releases depName=tombi packageName=tombi-toml/tombi #}
yamlfmt = "0.21.0"{# renovate: datasource=github-releases depName=yamlfmt packageName=google/yamlfmt #}
yamllint = "1.38.0"{# renovate: datasource=pypi depName=yamllint packageName=yamllint #}
{%- if language == "rust" %}
rust = { version = "1.97.0"{# renovate: datasource=github-releases depName=rust packageName=rust-lang/rust #}, components = "rustfmt,clippy" }
{%- elif language == "python" %}
ruff = "0.16.3"{# renovate: datasource=github-releases depName=ruff packageName=astral-sh/ruff #}
ty = "0.0.72"{# renovate: datasource=github-releases depName=ty packageName=astral-sh/ty #}
uv = "0.12.5"{# renovate: datasource=github-releases depName=uv packageName=astral-sh/uv #}
{%- endif %}

[tasks.check]
description = "Run all checks"
run = "hk check --all"

[tasks.fix]
description = "Fix all issues"
run = "hk fix --all"
{%- if language == "rust" %}

[tasks.test]
description = "Run tests"
run = "cargo test"
{%- elif language == "python" %}

[tasks.test]
description = "Run tests"
run = "uv run pytest"
{%- else %}

[tasks.test]
description = "Run tests"
run = "true"
{%- endif %}

[tasks."repo:sync"]
description = "Sync GitHub settings, labels and rulesets to the standard"
run = "bash scripts/repo-sync.sh"
