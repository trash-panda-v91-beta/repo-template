[tools]
actionlint = "1.7.12"
hk = "2.6.0"
pkl = "0.32.1"
rumdl = "0.2.55"
shellcheck = "0.11.0"
tombi = "1.4.0"
yamlfmt = "0.21.0"
yamllint = "1.38.0"
{%- if language == "rust" %}
rust = { version = "1.97.0", components = "rustfmt,clippy" }
{%- elif language == "python" %}
ruff = "0.16.3"
ty = "0.0.72"
uv = "0.12.5"
{%- endif %}

[tasks.check]
description = "Run all checks"
run = "hk check --all"

[tasks.fix]
description = "Fix all issues"
run = "hk fix --all"
{%- if language == "rust" %}

[tasks.test]
description = "Run tests"
run = "cargo test"
{%- elif language == "python" %}

[tasks.test]
description = "Run tests"
run = "uv run pytest"
{%- endif %}

[tasks."repo:sync"]
description = "Sync GitHub settings, labels and rulesets to the standard"
run = "scripts/repo-sync.sh"
