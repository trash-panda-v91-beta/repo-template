[package]
{% if language == "python" -%}
versioned_files = ["pyproject.toml"]
{%- elif language == "rust" -%}
versioned_files = ["Cargo.toml", "Cargo.lock"]
{%- else -%}
versioned_files = []
{%- endif %}
changelog = "CHANGELOG.md"
extra_changelog_sections = [
  { name = "Security", types = [
    "security",
  ] },
  { name = "Breaking Changes", types = [
    "major",
  ] },
  { name = "Features", types = [
    "minor",
    "feature",
  ] },
  { name = "Fixes", types = [
    "patch",
  ] },
  { name = "Documentation", types = [
    "docs",
  ] },
  { name = "Notes", types = [
    "note",
  ] },
]

# Forgejo speaks the Gitea API, so knope opens the release PR and publishes the
# release itself. The token comes from the GITEA_TOKEN variable, never from here.
[gitea]
owner = "{{ git_owner }}"
repo = "{{ repo_name }}"
host = "{{ git_host }}"

[[workflows]]
name = "prepare-release"
help_text = "Bump the version, write the changelog and open the release PR"

[[workflows.steps]]
type = "Command"
command = "git switch -c release"

[[workflows.steps]]
type = "PrepareRelease"

[[workflows.steps]]
type = "Command"
command = "git commit -m \"chore: prepare release $version\""

[workflows.steps.variables]
"$version" = "Version"

[[workflows.steps]]
type = "Command"
command = "git push --force --set-upstream origin release"

[[workflows.steps]]
type = "CreatePullRequest"
base = "main"

[workflows.steps.title]
template = "chore: prepare release $version"

[workflows.steps.title.variables]
"$version" = "Version"

[workflows.steps.body]
template = "Version bump and changelog generated by knope. Merging this releases $version."

[workflows.steps.body.variables]
"$version" = "Version"

[[workflows]]
name = "release"
help_text = "Tag the release and publish it"

[[workflows.steps]]
type = "Release"
