{%- set hk_version = "2.8.0" %}{# renovate: datasource=github-releases depName=hk packageName=jdx/hk #}
amends "package://github.com/jdx/hk/releases/download/v{{ hk_version }}/hk@{{ hk_version }}#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v{{ hk_version }}/hk@{{ hk_version }}#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v{{ hk_version }}/hk@{{ hk_version }}#/Config.pkl" as Config

fail_fast = false

local linters = new Mapping<String, Step> {
  ["actionlint"] = Builtins.actionlint
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["rumdl"] = Builtins.rumdl
  ["shellcheck"] = Builtins.shellcheck
  ["tombi"] = Builtins.tombi
  ["tombi-format"] = Builtins.tombi_format
  ["yamlfmt"] = Builtins.yamlfmt
  ["yamllint"] = Builtins.yamllint
{%- if language == "rust" %}
  ["cargo-fmt"] = new Config.Step {
    glob = "**/*.rs"
    check = "cargo fmt --check"
    fix = "cargo fmt"
    exclusive = true
  }
  ["cargo-clippy"] = new Config.Step {
    glob = "**/*.rs"
    check = "cargo clippy --quiet -- -D warnings"
    fix = "cargo clippy --fix --allow-dirty --allow-staged --quiet"
    exclusive = true
    env {
      ["CARGO_TERM_PROGRESS_WHEN"] = "never"
    }
  }
{%- elif language == "python" %}
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = Builtins.ruff_format
  ["ty"] = Builtins.ty
{%- endif %}
}

hooks {
  ["check"] {
    fix = false
    steps = linters
  }
  ["fix"] {
    fix = true
    stash = "none"
    steps = linters
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
}
